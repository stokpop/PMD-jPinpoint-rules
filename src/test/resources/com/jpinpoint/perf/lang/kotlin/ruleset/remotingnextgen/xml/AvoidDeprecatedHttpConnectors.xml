<?xml version="1.0" encoding="UTF-8"?>
<test-data xmlns="http://pmd.sourceforge.net/rule-tests"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://pmd.sourceforge.net/rule-tests http://pmd.sourceforge.net/rule-tests_1_0_0.xsd">
    <test-code>
        <description>violation: deprecated Apache commons httpclient import</description>
        <expected-problems>1</expected-problems>
        <expected-linenumbers>1</expected-linenumbers>
        <code><![CDATA[
import org.apache.commons.httpclient.HttpClient
class BadCommonsImport
]]></code>
    </test-code>

    <test-code>
        <description>violation: deprecated DefaultHttpClient import</description>
        <expected-problems>1</expected-problems>
        <expected-linenumbers>1</expected-linenumbers>
        <code><![CDATA[
import org.apache.http.impl.client.DefaultHttpClient
class BadDefaultImport
]]></code>
    </test-code>

    <test-code>
        <description>no violation: modern Apache client5 import</description>
        <expected-problems>0</expected-problems>
        <code><![CDATA[
import org.apache.hc.client5.http.classic.HttpClient
class GoodModernImport
]]></code>
    </test-code>
</test-data>
